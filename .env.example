# Printer model profile
LW_PROFILE=lw-px400

# Transport: rfcomm | usb | serial | file (file = dry run, writes job bytes to /data/jobs)
LW_TRANSPORT=file

# Bluetooth (rfcomm): printer MAC from `bluetoothctl devices`
LW_BT_ADDRESS=
LW_BT_CHANNEL=1

# Serial alternative (after `rfcomm bind 0 <MAC> 1`)
# LW_SERIAL_PATH=/dev/rfcomm0

# USB: Epson VID is 04b8; set PID / product match once `labelworks probe` shows them
# LW_USB_PID=
# LW_USB_PRODUCT=LW-PX400

# Used when the loaded tape can't be detected
LW_DEFAULT_TAPE_MM=12

# Real printing stays off until the PX400 profile is confirmed on hardware.
LW_ALLOW_UNVERIFIED=0

# HTTP server
LW_PORT=8765
# Static bearer token required on /mcp (set the same header in Obot). Empty = no auth.
LW_MCP_TOKEN=
# Comma-separated Host headers to accept (enables DNS-rebinding protection). Empty = any.
LW_ALLOWED_HOSTS=
